CONFIG_ACPI=y
CONFIG_ACPI_PROCESSOR=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y

# ACPI PM timer: lets the kernel calibrate the LAPIC timer against it instead of
# verifying against jiffies. On slow hosts (emulation) the jiffies check fails,
# the LAPIC timer is disabled, no CPU ever enters high-res tick mode, and kstep
# cannot take over the tick.
CONFIG_X86_PM_TIMER=y

# virtio console ports over PCI (QEMU -device virtio-serial-pci)
CONFIG_PCI=y
CONFIG_VIRTIO_PCI=y

# Kernel console: the pc machine's 16550 (ttyS0)
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
