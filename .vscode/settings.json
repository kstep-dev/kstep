{
    "files.exclude": {
        // python cache
        "**/__pycache__": true,
        // build artifacts
        "**/*.cmd": true,
    },
    "files.associations": {
        "**/linux/config.*": "makefile",
    },
    "search.exclude": {
        "build": true,
    },
    "python.analysis.exclude": [
        "**/node_modules",
        "**/.*",
        "**/.venv",
        "**/__pycache__",
        "**/build"
    ],
}
